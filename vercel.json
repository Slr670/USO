{
  "version": 2,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp4|mov)",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/FORTH_MASTER_Video_Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/assets/media/FORTH_MASTER_Video_Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/media/FORTH_MASTER_Video_Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    }
  ]
}
