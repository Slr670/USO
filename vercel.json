{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)\\.(mp4|mov)",
      "headers": [
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/FORTH_MASTER_Video_Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/assets/media/FORTH_MASTER_Video_Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/media/FORTH_MASTER_Video_Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/FORTH_MASTER_Video%20Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/assets/media/FORTH_MASTER_Video%20Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/media/FORTH_MASTER_Video%20Final-Additional.mp4",
      "destination": "/public/FORTH_MASTER_Video_Final-Additional.mp4"
    },
    {
      "source": "/((?!api/|_next/|public/|assets/|scripts/|styles/|icons/|favicon\\.ico|.*\\.(?:ico|png|jpg|jpeg|svg|css|js|mp4|mov|webmanifest|json|woff|woff2|ttf|map)$).*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
